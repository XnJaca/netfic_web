---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** JSON-LD adicional de la página (Service, FAQPage, etc.). */
  schema?: Record<string, unknown>[];
}

const {
  title = "NetFic Solutions — Infraestructura tecnológica + desarrollo",
  description = "Empresa de servicios tecnológicos en Costa Rica: redes, fibra óptica, CCTV, centrales telefónicas, eléctrico, A/C y desarrollo de software a medida.",
  schema = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/banner_home.png", Astro.site).toString();

const business = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": new URL("/#business", Astro.site).toString(),
  name: "NetFic Solutions",
  url: new URL("/", Astro.site).toString(),
  logo: new URL("/netfic-logo.png", Astro.site).toString(),
  image: ogImage,
  description: "Empresa de servicios tecnológicos en Costa Rica: redes, fibra óptica, CCTV, centrales telefónicas, eléctrico, climatización y desarrollo de software a medida.",
  telephone: "+506 8508 2921",
  email: "info@netficsolutions.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "San Ramón",
    addressRegion: "Alajuela",
    addressCountry: "CR",
  },
  areaServed: { "@type": "Country", name: "Costa Rica" },
};
const jsonLd = [business, ...schema];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="theme-color" content="#78C643" />
    <meta name="apple-mobile-web-app-title" content="NetFic" />

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NetFic Solutions" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <script>
      import Alpine from "alpinejs";
      (window as any).Alpine = Alpine;
      Alpine.start();
    </script>
  </head>
  <body class="bg-paper text-ink">
    <div class="flex min-h-screen flex-col">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -60px 0px" },
      );

      const init = () => {
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
      };

      init();
      document.addEventListener("astro:after-swap", init);
    </script>
  </body>
</html>
