---
const year = new Date().getFullYear();

const cols = [
  {
    title: "Servicios",
    links: [
      { label: "Redes Wi-Fi enterprise", href: "/servicios/redes-inalambricas" },
      { label: "Cableado estructurado", href: "/servicios/cableado-estructurado" },
      { label: "Fibra óptica", href: "/servicios/fibra-optica" },
      { label: "Videovigilancia CCTV", href: "/servicios/videovigilancia" },
      { label: "Centrales IP", href: "/servicios/centrales-telefonicas" },
      { label: "Instalaciones eléctricas", href: "/servicios/instalaciones-electricas" },
      { label: "Aires acondicionados", href: "/servicios/aires-acondicionados" },
      { label: "Venta de equipos", href: "/servicios/venta-equipos" },
    ],
  },
  {
    title: "Empresa",
    links: [
      { label: "Desarrollo de software", href: "/desarrollo" },
      { label: "Sobre NetFic", href: "/sobre-netfic" },
      { label: "Contacto", href: "/contacto" },
    ],
  },
  {
    title: "Contacto",
    links: [
      { label: "info@netfic.com", href: "mailto:info@netfic.com" },
      { label: "+506 8508 2921", href: "tel:+50685082921" },
      { label: "Costa Rica · GMT-6", href: null },
    ],
  },
];
---

<footer
  class="border-t"
  style="border-color: var(--color-line); background-color: var(--color-paper);"
>
  <div class="container-craft pt-24 pb-12">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_2.6fr] lg:gap-20 mb-16">
      <div>
        <a href="/" class="inline-block" aria-label="NetFic">
          <img src="/netficlogo.svg" alt="NetFic" style="height: 64px; width: auto;" />
        </a>
        <p
          class="mt-6 max-w-[42ch] text-[0.95rem] leading-relaxed"
          style="color: var(--color-ink-soft);"
        >
          Empresa de servicios tecnológicos en Costa Rica. Infraestructura y desarrollo, con trabajo documentado y mantenimiento sostenido.
        </p>
      </div>

      <div class="grid gap-10 sm:grid-cols-3">
        {cols.map((col) => (
          <div>
            <div class="eyebrow mb-5">{col.title}</div>
            <ul class="space-y-3">
              {col.links.map((link) => (
                <li>
                  {link.href ? (
                    <a
                      href={link.href}
                      class="text-[0.9375rem] transition-colors duration-150"
                      style="color: var(--color-ink-soft);"
                      onmouseover="this.style.color='var(--color-spark-deep)'"
                      onmouseout="this.style.color='var(--color-ink-soft)'"
                    >
                      {link.label}
                    </a>
                  ) : (
                    <span class="text-[0.9375rem]" style="color: var(--color-ink-soft);">
                      {link.label}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div
      class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-8 border-t text-[0.8125rem]"
      style="border-color: var(--color-line); color: var(--color-mute);"
    >
      <div>© {year} NetFic Solutions. Todos los derechos reservados.</div>
      <div>San Ramón, Alajuela</div>
    </div>
  </div>
</footer>
