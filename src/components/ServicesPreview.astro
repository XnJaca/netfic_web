---
const featured = {
  number: "01",
  name: "Redes Wi-Fi enterprise",
  body: "Diseño e instalación de redes inalámbricas medidas — site survey, AP enterprise, segmentación VLAN y monitoreo. Para oficinas, hotelería y casas con cobertura difícil.",
  image: "/redes_inalambricas.png",
  href: "/servicios/redes-inalambricas",
  tag: "Más solicitado",
};

const rest = [
  { number: "02", name: "Cableado estructurado", body: "Categoría 6 y 6A certificado, etiquetado y documentado.", href: "/servicios/cableado-estructurado" },
  { number: "03", name: "Fibra óptica", body: "Tendido y fusionado para enlace entre edificios o backbone.", href: "/servicios/fibra-optica" },
  { number: "04", name: "Videovigilancia CCTV", body: "Cámaras IP, acceso remoto, NVR con grabación local + nube.", href: "/servicios/videovigilancia" },
  { number: "05", name: "Centrales IP", body: "Centrales telefónicas VoIP, troncales SIP, integración con CRM.", href: "/servicios/centrales-telefonicas" },
  { number: "06", name: "Instalaciones eléctricas", body: "Residencial y comercial, tableros, UPS, puesta a tierra.", href: "/servicios/instalaciones-electricas" },
  { number: "07", name: "Aires acondicionados", body: "Venta, instalación y mantenimiento. Mini split, multi y central.", href: "/servicios/aires-acondicionados" },
  { number: "08", name: "Venta de equipos", body: "Distribución con garantía: switches, APs, cámaras, fibra y herramienta.", href: "/servicios/venta-equipos" },
];
---

<section
  id="servicios"
  class="border-t"
  style="border-color: var(--color-line); background-color: var(--color-paper);"
>
  <div class="container-craft py-24 md:py-32">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-20 mb-16 md:mb-20">
      <div class="reveal">
        <div class="eyebrow mb-4">02 · Lo que hacemos</div>
        <h2 class="display-xl" style="color: var(--color-ink);">
          Ocho líneas.<br />
          <span class="mark-brand">Un solo equipo.</span>
        </h2>
      </div>
      <p
        class="reveal reveal-d1 text-[1.0625rem] leading-relaxed self-end max-w-[58ch]"
        style="color: var(--color-ink-soft);"
      >
        No subcontratamos lo que pueda hacer alguien de la casa. Cada instalación la corre alguien que conoce el equipo, la norma y el contexto del cliente. Documentación entregada al final de cada proyecto.
      </p>
    </div>

    <a
      href={featured.href}
      class="reveal group block relative overflow-hidden mb-16 md:mb-20"
      style="border-radius: 18px; background-color: var(--color-ink); color: var(--color-paper); aspect-ratio: 16 / 7;"
    >
      <div class="absolute inset-0 grid lg:grid-cols-2">
        <div class="relative p-8 md:p-12 lg:p-14 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span
              class="text-[0.7rem] uppercase font-bold"
              style="letter-spacing: 0.22em; color: var(--color-brand);"
            >
              {featured.number} · Featured
            </span>
            <span
              class="px-3 py-1 rounded-full text-[0.7rem] font-bold uppercase"
              style="background-color: var(--color-spark); color: var(--color-ink); letter-spacing: 0.1em;"
            >
              {featured.tag}
            </span>
          </div>
          <div>
            <h3
              class="display-xl"
              style="color: var(--color-paper); font-size: clamp(2rem, 4.2vw, 3.5rem); letter-spacing: -0.035em;"
            >
              {featured.name}
            </h3>
            <p
              class="mt-5 max-w-[44ch] text-[0.95rem] leading-relaxed"
              style="color: rgba(250,250,247,0.78);"
            >
              {featured.body}
            </p>
            <div
              class="mt-7 inline-flex items-center gap-2 text-[0.875rem] font-semibold transition-transform duration-200 group-hover:translate-x-1"
              style="color: var(--color-spark);"
            >
              Ver detalle
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>
        </div>
        <div class="relative hidden lg:block">
          <img
            src={featured.image}
            alt={featured.name}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-contain p-10 transition-transform duration-500 group-hover:scale-[1.04]"
            style="filter: drop-shadow(0 20px 40px rgba(0,0,0,0.35));"
          />
        </div>
      </div>
    </a>

    <div class="grid lg:grid-cols-2 gap-x-12">
      {rest.map((service, i) => (
        <a
          href={service.href}
          class={`group grid grid-cols-[56px_1fr_24px] gap-5 py-7 border-t transition-colors duration-200 reveal reveal-d${Math.min((i % 4) + 1, 4)}`}
          style="border-color: var(--color-line);"
          onmouseover="this.style.borderColor='var(--color-ink)'"
          onmouseout="this.style.borderColor='var(--color-line)'"
        >
          <div
            class="tabular-nums leading-none self-center"
            style="font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; letter-spacing: -0.03em; color: var(--color-brand-deep);"
          >
            {service.number}
          </div>
          <div>
            <h3
              class="display-l"
              style="font-size: 1.375rem; color: var(--color-ink);"
            >
              {service.name}
            </h3>
            <p
              class="mt-1.5 text-[0.9rem] leading-relaxed max-w-[52ch]"
              style="color: var(--color-ink-soft);"
            >
              {service.body}
            </p>
          </div>
          <svg
            class="self-center transition-transform duration-200 group-hover:translate-x-1"
            width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
            style="color: var(--color-ink-soft);"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      ))}
    </div>

    <div class="mt-16 md:mt-20 flex justify-end reveal">
      <a
        href="/servicios"
        class="group inline-flex items-baseline gap-3 font-display font-bold transition-opacity hover:opacity-70"
        style="font-size: clamp(1.5rem, 2.5vw, 2rem); letter-spacing: -0.035em; color: var(--color-ink);"
      >
        Ver las ocho líneas en detalle
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="self-center transition-transform duration-300 group-hover:translate-x-1">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>
