---
// Hero — brand-led modern tech con impacto
---

<section class="container-craft pt-12 md:pt-16 pb-20 md:pb-28 relative">
  <div class="grid gap-10 lg:grid-cols-[1.45fr_1fr] lg:gap-16 lg:items-end">
    <div class="relative">
      <div class="flex items-center gap-3 reveal">
        <span
          class="inline-flex h-2 w-2 rounded-full relative"
          style="background-color: var(--color-brand);"
        >
          <span
            class="absolute inline-flex h-full w-full rounded-full opacity-75 animate-ping"
            style="background-color: var(--color-brand);"
          ></span>
        </span>
        <span class="eyebrow" style="letter-spacing: 0.2em;">
          Servicios tecnológicos · Costa Rica
        </span>
      </div>

      <h1 class="reveal reveal-d1 mt-7 display-hero" style="color: var(--color-ink);">
        Infraestructura<br />
        que <span class="mark-spark">no falla</span>,<br />
        <span class="mark-brand">conectada</span> bien.
      </h1>

      <p
        class="reveal reveal-d2 mt-8 max-w-[44ch]"
        style="font-size: 1.15rem; line-height: 1.55; color: var(--color-ink-soft);"
      >
        Instalamos y mantenemos redes, fibra óptica, CCTV, centrales IP, eléctrico y climatización para empresas y hogares en toda Costa Rica.
      </p>

      <div class="reveal reveal-d3 mt-10 flex flex-wrap items-center gap-3">
        <a href="/contacto" class="btn-primary">
          Solicitar cotización
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#servicios" class="btn-ghost">
          Ver servicios
        </a>
      </div>

      <div class="reveal reveal-d4 mt-14 flex flex-wrap gap-2">
        <span class="chip">Redes Wi-Fi enterprise</span>
        <span class="chip">Fibra óptica</span>
        <span class="chip">CCTV IP</span>
        <span class="chip">Centrales VoIP</span>
        <span class="chip">Eléctrico</span>
        <span class="chip">A/C</span>
        <span class="chip chip-brand">Desarrollo de software</span>
      </div>
    </div>

    <div class="reveal reveal-d2 relative">
      <div class="relative">
        <figure
          class="relative overflow-hidden"
          style="aspect-ratio: 4 / 5; border-radius: 14px; background-color: var(--color-paper-2);"
        >
          <img
            src="/about_1.jpeg"
            alt="Técnico de NetFic durante una instalación de equipo en Guanacaste, Costa Rica"
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </figure>

        <div
          class="absolute -bottom-5 -left-5 px-4 py-3 rounded-xl border shadow-sm"
          style="background-color: var(--color-paper); border-color: var(--color-line);"
        >
          <div class="eyebrow" style="font-size: 0.62rem;">En campo</div>
          <div
            class="mt-1 text-[0.875rem] font-semibold"
            style="font-family: var(--font-display); letter-spacing: -0.02em; color: var(--color-ink);"
          >
            Guanacaste · 2025
          </div>
        </div>

        <div
          class="absolute -top-4 -right-4 inline-flex items-center gap-2 px-3.5 py-2 rounded-full"
          style="background-color: var(--color-spark); color: var(--color-ink);"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
            <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
            <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
            <line x1="12" y1="20" x2="12.01" y2="20"></line>
          </svg>
          <span class="text-[0.78rem] font-bold uppercase" style="letter-spacing: 0.08em;">
            Activo
          </span>
        </div>
      </div>
    </div>
  </div>

  <div
    class="mt-20 md:mt-28 grid grid-cols-2 md:grid-cols-4 gap-px border-t reveal reveal-d5"
    style="border-color: var(--color-line);"
  >
    <div class="pt-7">
      <div
        class="display-l tabular-nums leading-none"
        style="color: var(--color-ink);"
      >
        10+
      </div>
      <div class="mt-2 text-[0.8rem]" style="color: var(--color-mute);">
        años en el campo
      </div>
    </div>
    <div class="pt-7">
      <div
        class="display-l tabular-nums leading-none"
        style="color: var(--color-ink);"
      >
        8
      </div>
      <div class="mt-2 text-[0.8rem]" style="color: var(--color-mute);">
        áreas de servicio
      </div>
    </div>
    <div class="pt-7">
      <div
        class="display-l tabular-nums leading-none"
        style="color: var(--color-ink);"
      >
        CR
      </div>
      <div class="mt-2 text-[0.8rem]" style="color: var(--color-mute);">
        cobertura nacional
      </div>
    </div>
    <div class="pt-7">
      <div
        class="display-l leading-none"
        style="color: var(--color-brand-deep);"
      >
        + dev
      </div>
      <div class="mt-2 text-[0.8rem]" style="color: var(--color-mute);">
        línea de software
      </div>
    </div>
  </div>
</section>
