---
const pathname = Astro.url.pathname;

const navItems = [
  { label: "Servicios", href: "/servicios" },
  { label: "Desarrollo", href: "/desarrollo" },
  { label: "Sobre NetFic", href: "/sobre-netfic" },
  { label: "Contacto", href: "/contacto" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};
---

<header
  x-data="{ open: false }"
  class="sticky top-0 z-40 border-b"
  style="background-color: rgba(250, 250, 247, 0.88); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-color: var(--color-line);"
>
  <div class="container-craft flex h-[76px] items-center justify-between">
    <a href="/" class="flex items-center gap-3" aria-label="NetFic Solutions">
      <img
        src="/netficlogo.svg"
        alt="NetFic"
        class="block"
        style="height: 56px; width: auto;"
      />
    </a>

    <nav class="hidden md:flex md:items-center md:gap-x-9" aria-label="Navegación principal">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class="text-[0.95rem] font-semibold transition-colors duration-200 relative"
            style={`color: ${active ? "var(--color-ink)" : "var(--color-ink-soft)"};`}
            onmouseover={`this.style.color='var(--color-ink)'`}
            onmouseout={`this.style.color='${active ? "var(--color-ink)" : "var(--color-ink-soft)"}'`}
          >
            {item.label}
            {active && (
              <span
                aria-hidden="true"
                class="absolute -bottom-2 left-0 right-0 h-[3px] rounded-full"
                style="background-color: var(--color-spark);"
              ></span>
            )}
          </a>
        );
      })}
      <a href="/contacto" class="btn-primary" style="padding: 0.7rem 1.25rem; font-size: 0.875rem;">
        Cotización
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </nav>

    <button
      type="button"
      class="md:hidden inline-flex items-center justify-center p-2 -mr-2"
      style="color: var(--color-ink);"
      @click="open = !open"
      :aria-expanded="open"
      aria-label="Abrir menú"
    >
      <svg x-show="!open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg x-show="open" x-cloak width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="md:hidden border-t"
    style="background-color: var(--color-paper); border-color: var(--color-line);"
  >
    <nav class="container-craft py-6 flex flex-col gap-y-4" aria-label="Navegación móvil">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-[1.125rem] font-semibold"
          style={`color: ${isActive(item.href) ? "var(--color-spark-deep)" : "var(--color-ink)"};`}
        >
          {item.label}
        </a>
      ))}
      <a href="/contacto" class="btn-primary mt-2 self-start">
        Cotización
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style is:global>
  [x-cloak] { display: none !important; }
</style>
