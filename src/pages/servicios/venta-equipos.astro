---
import Layout from "../../layouts/Layout.astro";
import ServicePage from "../../components/ServicePage.astro";
import { services, serviceJsonLd } from "../../data/services";

const service = services["venta-equipos"];
---

<Layout
  title={`${service.seoTitle} | NetFic Solutions`}
  description={service.seoDescription}
  schema={serviceJsonLd(service, Astro.site!)}
>
  <ServicePage service={service} />
</Layout>
