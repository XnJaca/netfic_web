---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ContactCTA from "../components/ContactCTA.astro";

const services = [
  {
    number: "01",
    name: "Redes Wi-Fi enterprise",
    body: "Diseño, instalación y configuración de redes inalámbricas de alto rendimiento — site survey, APs enterprise, segmentación VLAN, sistemas de gestión centralizada.",
    image: "/redes_inalambricas.png",
    href: "/servicios/redes-inalambricas",
    bullets: ["Análisis de cobertura", "WPA3 + segmentación", "Roaming sin cortes"],
    tag: "Más solicitado",
  },
  {
    number: "02",
    name: "Cableado estructurado",
    body: "Categoría 6 y 6A certificado, racks ordenados, paneles de parcheo etiquetados y reportes de certificación por punto.",
    image: "/cableado_estructurado.png",
    href: "/servicios/cableado-estructurado",
    bullets: ["Cat 6 / 6A", "Certificación por punto", "Documentación de rack"],
  },
  {
    number: "03",
    name: "Fibra óptica",
    body: "Tendido y fusionado de fibra para enlace entre edificios, backbone interno o instalación de ISP local. Pruebas OTDR y fichas técnicas.",
    image: "/fibra_optica.png",
    href: "/servicios/fibra-optica",
    bullets: ["Fusionado certificado", "Pruebas OTDR", "Enlaces punto-a-punto"],
  },
  {
    number: "04",
    name: "Videovigilancia CCTV",
    body: "Cámaras IP de última generación, NVR con grabación local + nube, acceso remoto desde cualquier dispositivo y analítica de eventos.",
    image: "/cctv1.png",
    href: "/servicios/videovigilancia",
    bullets: ["Cámaras IP 4K", "Acceso remoto", "Grabación híbrida"],
  },
  {
    number: "05",
    name: "Centrales telefónicas IP",
    body: "Centrales VoIP modernas, troncales SIP, integración con CRM y reportes de llamadas. Para empresas que dejan atrás la telefonía analógica.",
    image: "/switch_red.png",
    href: "/servicios/centrales-telefonicas",
    bullets: ["VoIP + SIP", "Integración CRM", "Reportes de tráfico"],
  },
  {
    number: "06",
    name: "Instalaciones eléctricas",
    body: "Residencial y comercial. Tableros, UPS, puesta a tierra, iluminación y proyectos eléctricos completos con planos certificados.",
    image: "/ups.png",
    href: "/servicios/instalaciones-electricas",
    bullets: ["Tableros + UPS", "Puesta a tierra", "Planos certificados"],
  },
  {
    number: "07",
    name: "Aires acondicionados",
    body: "Venta, instalación, reparación y mantenimiento. Mini split, multi split y central. Marcas con respaldo regional y garantía extendida.",
    image: "/aire_acondicionado.png",
    href: "/servicios/aires-acondicionados",
    bullets: ["Mini / Multi / Central", "Mantenimiento preventivo", "Garantía extendida"],
    tag: "Nuevo",
  },
  {
    number: "08",
    name: "Venta de equipos",
    body: "Distribución de equipos y accesorios de telecomunicaciones, seguridad y redes de las mejores marcas — con garantía y soporte directo.",
    image: "/access_point.png",
    href: "/servicios/venta-equipos",
    bullets: ["Equipo enterprise", "Garantía oficial", "Soporte directo"],
  },
];
---

<Layout
  title="Servicios — NetFic Solutions"
  description="Ocho líneas de servicio: redes Wi-Fi, cableado estructurado, fibra óptica, CCTV, centrales IP, eléctrico, A/C y venta de equipos."
>
  <PageHero
    eyebrow="02 · Servicios"
    title="Ocho líneas."
    highlight="Un solo equipo."
    highlightColor="brand"
    body="No subcontratamos lo que pueda hacer alguien de la casa. Cada instalación la corre alguien que conoce el equipo, la norma y el contexto del cliente."
  />

  <section class="container-craft py-16 md:py-20">
    <div class="flex flex-col">
      {services.map((service, i) => {
        const reversed = i % 2 === 1;
        return (
          <a
            href={service.href}
            class={`group grid gap-8 lg:grid-cols-[88px_1.2fr_1fr] lg:gap-12 py-14 md:py-20 border-b transition-colors duration-200 reveal reveal-d${Math.min((i % 4) + 1, 4)}`}
            style="border-color: var(--color-line);"
          >
            <div
              class="tabular-nums leading-none self-start"
              style="font-family: var(--font-display); font-weight: 700; font-size: clamp(2.5rem, 4vw, 3.5rem); letter-spacing: -0.04em; color: var(--color-brand-deep);"
            >
              {service.number}
            </div>

            <div class={`${reversed ? "lg:order-3" : ""}`}>
              <div class="flex items-baseline gap-3 mb-3">
                <h2
                  class="display-xl"
                  style="font-size: clamp(1.875rem, 3.6vw, 2.75rem); color: var(--color-ink); line-height: 1;"
                >
                  {service.name}
                </h2>
                {service.tag && (
                  <span
                    class="text-[0.65rem] uppercase font-bold px-2.5 py-1 rounded-full shrink-0 self-center"
                    style={`letter-spacing: 0.1em; background-color: var(--color-spark); color: var(--color-ink);`}
                  >
                    {service.tag}
                  </span>
                )}
              </div>
              <p
                class="text-[1.0625rem] leading-relaxed max-w-[54ch] mb-6"
                style="color: var(--color-ink-soft);"
              >
                {service.body}
              </p>
              <ul class="flex flex-wrap gap-2 mb-7">
                {service.bullets.map((b) => (
                  <li
                    class="text-[0.8rem] px-3 py-1.5 rounded-full"
                    style="background-color: var(--color-paper-2); color: var(--color-ink-soft); border: 1px solid var(--color-line);"
                  >
                    {b}
                  </li>
                ))}
              </ul>
              <div
                class="inline-flex items-center gap-2 text-[0.9rem] font-semibold transition-transform duration-200 group-hover:translate-x-1"
                style="color: var(--color-ink); border-bottom: 2px solid var(--color-spark); padding-bottom: 2px;"
              >
                Ver detalle del servicio
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </div>

            <div
              class={`relative overflow-hidden self-center ${reversed ? "lg:order-2" : ""}`}
              style="aspect-ratio: 4 / 3; background-color: var(--color-paper-2); border-radius: 14px;"
            >
              <img
                src={service.image}
                alt={service.name}
                loading="lazy"
                class="absolute inset-0 h-full w-full object-contain p-10 transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <ContactCTA />
</Layout>
